# REPLICATE_API_TOKEN: Replicate API token for serverless GPU video generation
# Get your token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN="r8_YOUR_REPLICATE_API_TOKEN"

# GEMINI_API_KEY: Optional Gemini API key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL of the deployed application
APP_URL="http://localhost:3000"

# HF_TOKEN: Hugging Face API Token (Inference API for video models)
# Set your token here or configure via the Admin Panel
HF_TOKEN=""

# MONGODB_URI: MongoDB Atlas connection string (optional - falls back to persistent storage)
MONGODB_URI=""

# ADMIN_PASSWORD: Password to access the isolated /admin-console dashboard
ADMIN_PASSWORD="AdminVideoMaker2026!"

